---
// Newsletter subscription capture component
---

<section
  class="border-border my-12 rounded-2xl border bg-muted/40 px-6 py-10 text-center"
>
  <p class="mb-1 text-sm font-semibold uppercase tracking-widest text-accent">
    Stay in the loop
  </p>
  <h2 class="mb-2 text-2xl font-bold">
    Get the latest China travel guides
  </h2>
  <p class="mx-auto mb-6 max-w-md text-muted-foreground">
    Visa updates, payment tips, hidden gems, and seasonal travel picks —
    delivered to your inbox every month. No spam, ever.
  </p>
  <form
    class="mx-auto flex max-w-md flex-col gap-3 sm:flex-row"
    onsubmit="handleNewsletterSubmit(event)"
    id="newsletter-form"
    novalidate
  >
    <label for="nl-email" class="sr-only">Email address</label>
    <input
      id="nl-email"
      name="email"
      type="email"
      required
      placeholder="your@email.com"
      class="flex-1 rounded-lg border border-border bg-background px-4 py-2.5 text-sm outline-none focus:border-accent focus:ring-2 focus:ring-accent/20"
    />
    <button
      type="submit"
      class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-foreground transition-opacity hover:opacity-90 active:opacity-75"
    >
      Subscribe →
    </button>
  </form>
  <p id="nl-message" class="mt-3 hidden text-sm text-accent"></p>
  <p class="mt-3 text-xs text-muted-foreground">
    Join 2,000+ travellers planning their China adventure. Unsubscribe anytime.
  </p>
</section>

<script>
  function handleNewsletterSubmit(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const emailInput = form.querySelector<HTMLInputElement>("#nl-email");
    const msg = document.querySelector<HTMLParagraphElement>("#nl-message");
    if (!emailInput || !msg) return;

    if (!emailInput.value || !/\S+@\S+\.\S+/.test(emailInput.value)) {
      msg.textContent = "Please enter a valid email address.";
      msg.classList.remove("hidden");
      return;
    }

    // In production, replace this with a real API call (e.g., Mailchimp, ConvertKit)
    msg.textContent =
      "🎉 You're subscribed! Check your inbox for a welcome email.";
    msg.classList.remove("hidden");
    emailInput.value = "";
    (form.querySelector("button") as HTMLButtonElement).disabled = true;
  }

  // Expose globally for inline onsubmit handler
  (window as typeof window & { handleNewsletterSubmit: typeof handleNewsletterSubmit }).handleNewsletterSubmit =
    handleNewsletterSubmit;
</script>
