// Simplified date display: "Updated May 2026"
const displayDate = modDatetime ?? pubDatetime;
const dateStr = displayDate.toLocaleDateString("en-US", { month: "short", year: "numeric" });
---

{cardStyle === "grid" ? (
  <!-- ── GRID CARD ── -->
  <li class="group">
    <a
      href={postUrl}
      class="flex h-full flex-col overflow-hidden rounded-2xl border border-border/70 bg-[var(--card-bg,#fff)] shadow-sm transition-all duration-350 hover:shadow-2xl hover:-translate-y-2.5 hover:border-accent/25"
    >
      <!-- Image -->
      <div class="relative h-48 overflow-hidden bg-muted">
        <img
          src={thumbnail}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-600 ease-out group-hover:scale-110"
          loading="lazy"
        />
        <!-- Gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/5 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
        <!-- Category badge -->
        {category && (
          <span class:list={["absolute top-3 left-3 rounded-full px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide shadow-sm backdrop-blur-sm", badgeClass]}>
            {category}
          </span>
        )}
        <!-- Arrow indicator on hover -->
        <div class="absolute right-3 bottom-3 flex size-7 items-center justify-center rounded-full bg-white/0 text-white/0 transition-all duration-300 group-hover:bg-white/25 group-hover:text-white">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </div>
      </div>

      <!-- Text body -->
      <div class="flex flex-1 flex-col p-4 sm:p-5">
        <Heading
          transition:name={slugifyStr(title.replaceAll(".", "-"))}
          class="mb-2 line-clamp-2 text-base font-bold leading-snug text-foreground transition-colors duration-200 group-hover:text-accent"
          style="font-family: var(--font-playfair), Georgia, serif; letter-spacing: -0.01em;"
        >
          {title}
        </Heading>
        <p class="flex-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
          {description}
        </p>
        <div class="mt-3 flex items-center justify-between">
          <p class="text-xs text-muted-foreground/65">
            Updated {dateStr}
          </p>
          <span class="text-xs font-medium text-muted-foreground/50 transition-colors group-hover:text-accent">
            Read →
          </span>
        </div>
      </div>
    </a>
  </li>
) : (
  <!-- ── LIST CARD ── -->
  <li class="group">
    <a
      href={postUrl}
      class="flex gap-4 rounded-2xl border border-border/70 bg-[var(--card-bg,#fff)] p-4 shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 hover:border-accent/25 sm:gap-5"
    >
      <!-- Thumbnail -->
      <div class="h-24 w-28 flex-shrink-0 overflow-hidden rounded-xl bg-muted sm:h-28 sm:w-36">
        <img
          src={thumbnail}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
        />
      </div>

      <!-- Text -->
      <div class="flex min-w-0 flex-1 flex-col justify-between">
        <div>
          {category && (
            <span class:list={["mb-2 inline-block rounded-full px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide", badgeClass]}>
              {category}
            </span>
          )}
          <Heading
            transition:name={slugifyStr(title.replaceAll(".", "-"))}
            class="line-clamp-2 text-base font-bold leading-snug text-foreground transition-colors duration-200 group-hover:text-accent sm:text-lg"
            style="font-family: var(--font-playfair), Georgia, serif; letter-spacing: -0.01em;"
          >
            {title}
          </Heading>
          <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
            {description}
          </p>
        </div>
        <p class="mt-2 text-xs text-muted-foreground/65">
          Updated {dateStr}
        </p>
      </div>
    </a>
  </li>
)}

<style>
  .group-hover\:scale-108:is(.group:hover *) { transform: scale(1.08); }
  .group:hover .group-hover\:scale-108 { transform: scale(1.08); }
  .group-hover\:scale-110:is(.group:hover *) { transform: scale(1.1); }
  .group:hover .group-hover\:scale-110 { transform: scale(1.1); }
  .duration-350 { transition-duration: 350ms; }
  .duration-600 { transition-duration: 600ms; }
</style>
