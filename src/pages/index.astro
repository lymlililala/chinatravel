<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    // ── Hero search bar ──
    const heroInput = document.getElementById("hero-search-input") as HTMLInputElement;
    const heroBtn = document.getElementById("hero-search-btn") as HTMLAnchorElement;
    if (heroInput && heroBtn) {
      const baseHref = heroBtn.getAttribute("href")?.split("?")[0] ?? "/search/";
      heroInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && heroInput.value.trim()) {
          window.location.href = `${baseHref}?q=${encodeURIComponent(heroInput.value.trim())}`;
        }
      });
      heroInput.addEventListener("input", () => {
        if (heroInput.value.trim()) {
          heroBtn.setAttribute("href", `${baseHref}?q=${encodeURIComponent(heroInput.value.trim())}`);
        } else {
          heroBtn.setAttribute("href", baseHref);
        }
      });
    }

    // ── Subtle parallax on hero background ──
    const heroImg = document.getElementById("hero-img");
    if (heroImg && window.innerWidth > 768) {
      const handleParallax = () => {
        const scrollY = window.scrollY;
        const vh = window.innerHeight;
        if (scrollY < vh) {
          (heroImg as HTMLElement).style.transform = `translateY(${scrollY * 0.28}px)`;
        }
      };
      window.addEventListener("scroll", handleParallax, { passive: true });
    }

    // ── Fade-up on scroll ──
    const fadeTargets = document.querySelectorAll(".observe-fade");
    if (!fadeTargets.length) return;

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("section-visible");
            const children = entry.target.querySelectorAll("a[class*='rounded'], li, .grid > *, .bento-item");
            children.forEach((child, i) => {
              (child as HTMLElement).style.animationDelay = `${i * 0.06}s`;
              child.classList.add("card-pop-in");
            });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05 }
    );
    fadeTargets.forEach(el => observer.observe(el));
  });
</script>

<style>
  /* Hero entrance animation */
  .hero-animate-in {
    animation: heroSlideUp 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  /* Section fade-in */
  .observe-fade {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  .observe-fade.section-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Card pop-in */
  @keyframes cardPopIn {
    from { opacity: 0; transform: translateY(18px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .card-pop-in {
    animation: cardPopIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* ── BENTO GRID LAYOUT ──
     Desktop: 4 columns, varied heights
     Tablet:  2 columns
     Mobile:  2 columns, equal height */

  .bento-grid {
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: auto;
  }

  /* Mobile: all equal height */
  .bento-item {
    aspect-ratio: 4/3;
  }

  @media (min-width: 640px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .bento-large { grid-column: span 1; aspect-ratio: 4/3; }
    .bento-medium { aspect-ratio: 4/3; }
    .bento-small { aspect-ratio: 4/3; }
  }

  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: 2fr 1.3fr 1fr 1fr;
      grid-template-rows: 260px 200px;
    }
