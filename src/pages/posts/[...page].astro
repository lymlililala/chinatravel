---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Noindex pagination beyond page 1 — "/posts/2/" and on are low-value,
// duplicative listing pages. Page 1 (/posts/) stays indexed. Mirrors the
// sitemap exclusion in astro.config.ts.
const noindex = page.currentPage > 1;

// Filter tabs
const filterTabs = [
  { label: "All Guides",   tag: null,            emoji: "📚" },
  { label: "Destinations", tag: "destinations",  emoji: "🗺️" },
  { label: "Essentials",   tag: "toolkit",       emoji: "🧰" },
  { label: "Food",         tag: "food",          emoji: "🍜" },
  { label: "Nature",       tag: "nature",        emoji: "🏔️" },
  { label: "Solo Travel",  tag: "solo",          emoji: "🎒" },
];
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`} noindex={noindex}>
  <Header />

  <main id="main-content" class="pb-0">

    <!-- Page header -->
    <div class="relative overflow-hidden border-b border-border bg-gradient-to-br from-background via-muted/30 to-background py-12 sm:py-16">
      <div class="pointer-events-none absolute -top-20 -right-20 h-64 w-64 rounded-full bg-accent/5 blur-3xl"></div>
      <div class="pointer-events-none absolute bottom-0 left-10 h-40 w-40 rounded-full bg-secondary/6 blur-3xl"></div>

      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <nav class="mb-4 flex items-center gap-2 text-sm text-muted-foreground" aria-label="Breadcrumb">
          <a href={getRelativeLocaleUrl(locale, "")} class="transition-colors hover:text-accent">Home</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-foreground font-medium">Articles</span>
          {page.currentPage > 1 && (
            <>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              <span class="text-foreground font-medium">Page {page.currentPage}</span>
            </>
          )}
        </nav>
        <h1
          class="text-4xl font-extrabold text-foreground sm:text-5xl"
          style="font-family: var(--font-playfair), Georgia, serif; letter-spacing: -0.03em;"
        >
          {t.pages.postsTitle}
        </h1>
        <p class="mt-2 text-lg text-muted-foreground">{t.pages.postsDesc}</p>

        <!-- Article count -->
        <p class="mt-4 text-sm text-muted-foreground">
          Showing <strong class="text-foreground">{page.data.length}</strong> of
          <strong class="text-foreground">{page.total}</strong> articles
          {page.currentPage > 1 && <span>· Page {page.currentPage} of {page.lastPage}</span>}
        </p>
      </div>
    </div>

    <!-- Sticky filter tabs -->
    <div class="sticky top-[var(--header-h,64px)] z-30 border-b border-border bg-background/97 backdrop-blur-xl">
      <div class="mx-auto max-w-7xl overflow-x-auto px-4 sm:px-6">
        <div class="flex gap-1 py-2.5" id="filter-tabs" role="group" aria-label="Filter articles by category">
          {filterTabs.map(tab => (
            <button
              data-tag={tab.tag ?? "all"}
              class:list={[
                "filter-tab flex-shrink-0 flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm font-semibold transition-all duration-200",
                "border",
                tab.tag === null
                  ? "bg-accent text-white border-accent shadow-sm shadow-accent/20"
                  : "border-border text-muted-foreground hover:text-foreground hover:bg-muted hover:border-border",
              ]}
            >
              <span class="text-sm" aria-hidden="true">{tab.emoji}</span>
              {tab.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Article grid with skeleton fallback -->
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">

      <!-- Skeleton screens (hidden after load) -->
      <ul id="skeleton-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" aria-hidden="true">
        {Array.from({ length: 6 }).map(() => (
          <li class="flex flex-col overflow-hidden rounded-2xl border border-border bg-[var(--card-bg)]">
            <div class="skeleton h-48 w-full rounded-none"></div>
            <div class="flex flex-col gap-3 p-4">
              <div class="skeleton h-4 w-20 rounded-full"></div>
              <div class="skeleton h-5 w-full"></div>
              <div class="skeleton h-4 w-3/4"></div>
              <div class="skeleton h-3 w-16 mt-1"></div>
            </div>
          </li>
        ))}
      </ul>

      <!-- Actual articles grid -->
      <ul id="posts-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 hidden">
        {page.data.map(data => (
          <Card variant="h2" cardStyle="grid" {...data} />
        ))}
      </ul>

      <!-- Empty state -->
      <div id="empty-state" class="hidden py-20 text-center">
        <span class="text-6xl">🔍</span>
        <p class="mt-5 text-xl font-semibold text-foreground">No articles in this category yet</p>
        <p class="mt-2 text-sm text-muted-foreground">Try another filter or browse all guides.</p>
        <button
          data-tag="all"
          class="filter-tab mt-5 inline-flex items-center gap-2 rounded-full border border-accent px-5 py-2 text-sm font-semibold text-accent transition-all hover:bg-accent hover:text-white"
        >
          Show all guides
        </button>
      </div>
    </div>

    <Pagination {page} />
  </main>

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const skeletonGrid = document.getElementById("skeleton-grid");
    const postsGrid = document.getElementById("posts-grid");

    // Reveal real content after a micro-delay (simulates data loaded)
    if (skeletonGrid && postsGrid) {
      requestAnimationFrame(() => {
        setTimeout(() => {
          skeletonGrid.classList.add("hidden");
          postsGrid.classList.remove("hidden");
          // Stagger card entrance
          const cards = postsGrid.querySelectorAll("li");
          cards.forEach((card, i) => {
            (card as HTMLElement).style.animationDelay = `${i * 0.05}s`;
            card.classList.add("card-pop-in");
          });
        }, 100);
      });
    }

    const tabs = document.querySelectorAll<HTMLButtonElement>(".filter-tab");
    const cards = document.querySelectorAll<HTMLLIElement>("#posts-grid > li");
    const emptyState = document.getElementById("empty-state");
    const grid = document.getElementById("posts-grid");

    if (!tabs.length) return;

    function setActiveTab(selectedTag: string) {
      // Update tab styles
      tabs.forEach(t => {
        const isActive = t.dataset.tag === selectedTag;
        t.classList.toggle("bg-accent", isActive);
        t.classList.toggle("text-white", isActive);
        t.classList.toggle("border-accent", isActive);
        t.classList.toggle("shadow-sm", isActive);
        t.classList.toggle("text-muted-foreground", !isActive);
        t.classList.toggle("border-border", !isActive);
        t.classList.remove("bg-muted");
      });

      // Filter cards
      let visibleCount = 0;
      cards.forEach((card) => {
        const tagBadge = card.querySelector("span[class*='rounded-full']");
        const cardTag = (tagBadge?.textContent ?? "").toLowerCase().trim();
        const matches = selectedTag === "all" || cardTag.includes(selectedTag);
        card.style.display = matches ? "" : "none";
        if (matches) {
          (card as HTMLElement).style.animationDelay = `${(visibleCount % 12) * 0.05}s`;
          card.classList.add("card-pop-in");
          visibleCount++;
        } else {
          card.classList.remove("card-pop-in");
        }
      });

      if (emptyState && grid) {
        emptyState.classList.toggle("hidden", visibleCount > 0);
        grid.classList.toggle("hidden", visibleCount === 0);
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener("click", () => setActiveTab(tab.dataset.tag ?? "all"));
    });
  });
</script>

<style>
  @keyframes cardPopIn {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .card-pop-in {
    animation: cardPopIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
</style>
