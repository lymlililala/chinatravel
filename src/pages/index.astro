---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import DestinationCard from "@/components/DestinationCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// Featured destinations data
const destinations = [
  {
    name: "Beijing",
    tagline: "Imperial grandeur meets modern China",
    imageUrl: "https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=600&q=80",
    imageAlt: "The Great Wall of China near Beijing",
    href: getRelativeLocaleUrl(locale, "tags/beijing"),
    highlights: ["Great Wall", "Forbidden City", "Temple of Heaven"],
  },
  {
    name: "Shanghai",
    tagline: "The city that never sleeps",
    imageUrl: "https://images.unsplash.com/photo-1537944434965-cf4679d1a598?w=600&q=80",
    imageAlt: "Shanghai Bund skyline at night",
    href: getRelativeLocaleUrl(locale, "tags/shanghai"),
    highlights: ["The Bund", "Yu Garden", "French Concession"],
  },
  {
    name: "Xi'an",
    tagline: "Cradle of Chinese civilisation",
    imageUrl: "https://images.unsplash.com/photo-1591451427710-ad34d2cfd9d1?w=600&q=80",
    imageAlt: "Terracotta Warriors in Xi'an",
    href: getRelativeLocaleUrl(locale, "tags/xian"),
    highlights: ["Terracotta Army", "City Wall", "Muslim Quarter"],
  },
  {
    name: "Chengdu",
    tagline: "Pandas, hotpot & laid-back vibes",
    imageUrl: "https://images.unsplash.com/photo-1569880153113-76e33fc52d5f?w=600&q=80",
    imageAlt: "Giant panda in Chengdu Research Base",
    href: getRelativeLocaleUrl(locale, "tags/chengdu"),
    highlights: ["Giant Pandas", "Hotpot", "Leshan Buddha"],
  },
  {
    name: "Guilin",
    tagline: "Karst mountains & emerald rivers",
    imageUrl: "https://images.unsplash.com/photo-1513415756790-2ac1db1297d0?w=600&q=80",
    imageAlt: "Li River karst scenery in Guilin",
    href: getRelativeLocaleUrl(locale, "tags/guilin"),
    highlights: ["Li River Cruise", "Longji Terraces", "Reed Flute Cave"],
  },
  {
    name: "Dali",
    tagline: "Ancient town by the Erhai Lake",
    imageUrl: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&q=80",
    imageAlt: "Old Town of Dali with Cangshan mountains",
    href: getRelativeLocaleUrl(locale, "tags/dali"),
    highlights: ["Old Town", "Erhai Lake", "Cangshan Mountains"],
  },
];

// Essential toolkit links
const toolkitGuides = [
  {
    icon: "🛂",
    title: "Visa & Entry",
    desc: "144-hour & 15-day visa-free transit explained",
    href: getRelativeLocaleUrl(locale, "tags/visa"),
    cta: "Read guide",
  },
  {
    icon: "💳",
    title: "Money & Payment",
    desc: "Link your foreign card to Alipay & WeChat Pay",
    href: getRelativeLocaleUrl(locale, "tags/payment"),
    cta: "Read guide",
  },
  {
    icon: "📱",
    title: "Apps & Internet",
    desc: "Must-have apps and VPN-free connectivity tips",
    href: getRelativeLocaleUrl(locale, "tags/apps"),
    cta: "Read guide",
  },
  {
    icon: "🚄",
    title: "Getting Around",
    desc: "How to book & ride China's high-speed trains",
    href: getRelativeLocaleUrl(locale, "tags/transport"),
    cta: "Read guide",
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
  >

    <!-- ═══ HERO SECTION ═══ -->
    <section
      id="hero"
      class="relative overflow-hidden border-b border-border"
      style="min-height: 480px;"
    >
      <!-- Background image -->
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1513415756790-2ac1db1297d0?w=1400&q=75"
          alt="Stunning karst landscape in Guilin, China"
          class="h-full w-full object-cover"
          loading="eager"
        />
        <!-- Deeper, more polished gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/80"></div>
      </div>

      <!-- Hero content -->
      <div class="app-layout relative z-10 flex flex-col items-start justify-end py-20 sm:py-28" style="min-height: 480px;">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-white/60">
          Your independent guide to
        </p>
        <h1 class="mb-4 text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl" style="font-family: var(--font-google-sans-code), monospace;">
          Travelling <span class="text-amber-400">China</span> in 2025
        </h1>
        <p class="mb-8 max-w-lg text-base text-white/80 sm:text-lg" style="font-family: var(--font-inter), system-ui, sans-serif; line-height: 1.7;">
          Honest advice on visas, payments, transport, and hidden gems —
          written for first-timers and seasoned backpackers alike.
        </p>
        <div class="flex flex-wrap gap-3">
          <!-- Primary CTA: solid accent -->
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white shadow-lg transition-all duration-200 hover:opacity-90 hover:shadow-xl hover:-translate-y-0.5"
          >
            Explore Guides
          </a>
          <!-- Secondary CTA: glassmorphism -->
          <a
            href="#toolkit"
            class="rounded-lg border border-white/50 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:bg-white/20 hover:border-white/70"
          >
            Essential Toolkit ↓
          </a>
        </div>
      </div>
    </section>

    <!-- ═══ ESSENTIAL TOOLKIT ═══ -->
    <section id="toolkit" class="border-b border-border py-14 observe-fade">
      <div class="app-layout">
        <div class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">
            Before you go
          </p>
          <h2 class="mt-1 text-2xl font-bold text-foreground">Essential Toolkit</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Everything international travellers need to know about navigating China.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {toolkitGuides.map((guide, i) => (
            <a
              href={guide.href}
              class:list={[
                "group flex flex-col gap-3 rounded-2xl p-5",
                "bg-[var(--card-bg,#fff)] border border-border",
                "shadow-sm transition-all duration-300",
                "hover:shadow-lg hover:-translate-y-1 hover:border-accent/30",
              ]}
            >
              <span class="text-4xl" aria-hidden="true">{guide.icon}</span>
              <div>
                <h3 class="font-bold text-foreground group-hover:text-accent transition-colors">
                  {guide.title}
                </h3>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{guide.desc}</p>
              </div>
              <span class="mt-auto flex items-center gap-1 text-sm font-semibold text-accent">
                {guide.cta}
                <IconArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ FEATURED DESTINATIONS ═══ -->
    <section id="destinations" class="border-b border-border py-14 observe-fade">
      <div class="app-layout">
        <div class="mb-8 flex items-end justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">
              Where to go
            </p>
            <h2 class="mt-1 text-2xl font-bold text-foreground">Featured Destinations</h2>
          </div>
          <LinkButton
            href={getRelativeLocaleUrl(locale, "tags")}
            class="flex items-center gap-1 text-sm font-medium text-accent hover:underline"
          >
            All destinations <IconArrowRight class="h-3.5 w-3.5" />
          </LinkButton>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {destinations.map(dest => (
            <DestinationCard {...dest} />
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ FEATURED ARTICLES ═══ -->
    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-b border-border py-14 observe-fade">
          <div class="app-layout">
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">
              Editor's picks
            </p>
            <h2 class="mt-1 mb-6 text-2xl font-bold text-foreground">{t.home.featured}</h2>
            <ul class="flex flex-col gap-3">
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- ═══ RECENT ARTICLES ═══ -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="border-b border-border py-14 observe-fade">
          <div class="app-layout">
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">
              Fresh off the press
            </p>
            <h2 class="mt-1 mb-6 text-2xl font-bold text-foreground">{t.home.recentPosts}</h2>
            <ul class="flex flex-col gap-3">
              {recentPosts.slice(0, postsConfig.perIndex).map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
            <div class="mt-8 text-center">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "posts")}
                class="inline-flex items-center gap-2 rounded-lg border border-accent px-6 py-2.5 text-sm font-semibold text-accent transition-all hover:bg-accent hover:text-white"
              >
                {t.home.allPosts}
                <IconArrowRight class="h-4 w-4 rtl:-rotate-180" />
              </LinkButton>
            </div>
          </div>
        </section>
      )
    }

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    // ── Fade-up on scroll using IntersectionObserver ──
    const fadeTargets = document.querySelectorAll(".observe-fade");
    if (!fadeTargets.length) return;

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("fade-up", "visible");
            // Stagger children cards
            const children = entry.target.querySelectorAll(
              "a[class*='rounded'], li"
            );
            children.forEach((child, i) => {
              (child as HTMLElement).style.animationDelay = `${i * 0.08}s`;
              child.classList.add("fade-up", "visible");
            });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08 }
    );

    fadeTargets.forEach(el => observer.observe(el));
  });
</script>
