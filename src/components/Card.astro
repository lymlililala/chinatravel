const firstTag = (tags?.[0] ?? "").toLowerCase().replace(/[^a-z]/g, "");

// 1) explicit destination tag → 2) destination keyword in title → 3) varied pool
let baseThumb: string | undefined;
if (!TOPIC_TAGS.has(firstTag) && thumbnailMap[firstTag]) {
  baseThumb = thumbnailMap[firstTag];
} else {
  const k = Object.keys(thumbnailMap).find(
    key => !TOPIC_TAGS.has(key) && key.length >= 4 && title.toLowerCase().includes(key)
  );
  if (k) baseThumb = thumbnailMap[k];
}
const tagThumbnail = baseThumb ?? poolPick(id);

// Prefer article's own local ogImage over the derived thumbnail
const { ogImage } = data;
const thumbnail = (typeof ogImage === "string" && ogImage.startsWith("/"))
  ? ogImage
