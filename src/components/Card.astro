// Variety pool — every local destination image, picked deterministically by
// slug hash so topic/listing cards don't all repeat the same photo.
const POOL = ["beijing","pingyao","harbin","tianjin","dalian","changbai","shanghai","hangzhou","huangshan","suzhou","qingdao","nanjing","anhui","xidi","jiangxi","wuhan","zhangjiajie","fenghuang","luoyang","guangzhou","hainan","guilin","gulangyu","chaoshan","fuzhou","macau","chengdu","chongqing","jiuzhaigou","lijiang","zhangye","yunnan","dali","guizhou","tibet","xishuangbanna","xian","dunhuang","xinjiang","qinghai","kashgar"];
function poolPick(seed: string): string {
  let h = 5381;
  for (let i = 0; i < seed.length; i++) h = ((h << 5) + h + seed.charCodeAt(i)) >>> 0;
  return `/destinations/${POOL[h % POOL.length]}.jpg`;
}

// Practical/topic tags don't map to a single place — give them varied imagery
