---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale ?? "en";

const footerLinks = {
  Destinations: [
    { label: "Beijing",     href: getRelativeLocaleUrl(locale, "tags/beijing") },
    { label: "Shanghai",    href: getRelativeLocaleUrl(locale, "tags/shanghai") },
    { label: "Xi'an",       href: getRelativeLocaleUrl(locale, "tags/xian") },
    { label: "Chengdu",     href: getRelativeLocaleUrl(locale, "tags/chengdu") },
    { label: "Guilin",      href: getRelativeLocaleUrl(locale, "tags/guilin") },
    { label: "Yunnan",      href: getRelativeLocaleUrl(locale, "tags/yunnan") },
    { label: "Tibet",       href: getRelativeLocaleUrl(locale, "tags/tibet") },
    { label: "All cities →", href: getRelativeLocaleUrl(locale, "tags") },
  ],
  "Essential Guides": [
    { label: "Visa & Entry",      href: getRelativeLocaleUrl(locale, "tags/visa") },
    { label: "Money & Payment",   href: getRelativeLocaleUrl(locale, "tags/payment") },
    { label: "Apps & Internet",   href: getRelativeLocaleUrl(locale, "tags/apps") },
    { label: "Getting Around",    href: getRelativeLocaleUrl(locale, "tags/transport") },
    { label: "Best Time to Visit",href: getRelativeLocaleUrl(locale, "tags/timing") },
    { label: "Food Guide",        href: getRelativeLocaleUrl(locale, "tags/food") },
  ],
  "Travel Styles": [
    { label: "Culture & History", href: getRelativeLocaleUrl(locale, "tags/culture") },
    { label: "Nature & Hiking",   href: getRelativeLocaleUrl(locale, "tags/nature") },
    { label: "Solo Travel",       href: getRelativeLocaleUrl(locale, "tags/solo") },
    { label: "Family Travel",     href: getRelativeLocaleUrl(locale, "tags/family") },
    { label: "Photography",       href: getRelativeLocaleUrl(locale, "tags/photography") },
    { label: "Beach & Tropical",  href: getRelativeLocaleUrl(locale, "tags/beach") },
  ],
};

const socialLinks = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
    bg: "bg-gradient-to-br from-pink-500 to-orange-400",
  },
  {
    name: "YouTube",
    href: "https://www.youtube.com/",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
    bg: "bg-red-500",
  },
  {
    name: "Pinterest",
    href: "https://www.pinterest.com/",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>`,
    bg: "bg-red-600",
  },
  {
    name: "WhatsApp",
    href: "https://wa.me/",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>`,
    bg: "bg-green-500",
  },
];
---

<footer
  class:list={["mt-auto", className]}
  {...attrs}
>
  <!-- Main footer area -->
  <div class="border-t border-border bg-[var(--section-alt)]">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">

        <!-- Brand column -->
        <div class="sm:col-span-2 lg:col-span-2">
          <!-- Logo -->
          <div class="mb-4 flex items-center gap-2">
            <span
              class="flex size-8 items-center justify-center rounded-lg bg-accent text-white text-sm font-black"
              aria-hidden="true"
            >旅</span>
            <span
              class="text-lg font-extrabold text-foreground"
              style="font-family: var(--font-playfair), Georgia, serif; letter-spacing: -0.02em;"
            >
              Roam<span class="text-accent">China</span>
              <span class="font-normal text-muted-foreground text-base"> Travel</span>
            </span>
          </div>
          <p class="mb-6 max-w-xs text-sm leading-relaxed text-muted-foreground">
            Your independent guide to travelling China — visas, payments, transport, and authentic local experiences for international visitors.
          </p>

          <!-- Social media icons -->
          <div class="mb-6 flex flex-wrap gap-2">
            {socialLinks.map(social => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class:list={[
                  "flex size-9 items-center justify-center rounded-xl text-white shadow-sm transition-all duration-200 hover:scale-110 hover:shadow-md",
                  social.bg,
                ]}
                set:html={social.icon}
              />
            ))}
          </div>

          <!-- Mini newsletter -->
          <div>
            <p class="mb-2.5 text-sm font-semibold text-foreground">Get weekly China travel tips</p>
            <form class="flex gap-2" onsubmit="return false;">
              <input
                type="email"
                placeholder="your@email.com"
                required
                class="min-w-0 flex-1 rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm text-foreground placeholder-muted-foreground outline-none transition-all focus:border-accent focus:ring-2 focus:ring-accent/20"
              />
              <button
                type="submit"
                class="rounded-xl bg-accent px-4 py-2.5 text-xs font-bold text-white transition-all hover:scale-105 hover:shadow-md hover:shadow-accent/25 active:scale-100"
              >
                Join
              </button>
            </form>
          </div>
        </div>

        <!-- Link columns -->
        {
          Object.entries(footerLinks).map(([section, links]) => (
            <div>
              <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-accent">
                {section}
              </h3>
              <ul class="space-y-2">
                {links.map(link => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-muted-foreground transition-colors hover:text-foreground hover:underline underline-offset-4"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-border bg-background">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-4 sm:flex-row sm:px-6">
      <p class="text-xs text-muted-foreground">
        {t.footer.copyright} &copy; {currentYear}
        <span class="font-semibold text-foreground">Roam China Travel</span>
        &nbsp;—&nbsp;{t.footer.allRightsReserved}
      </p>
      <div class="flex items-center gap-4 text-xs text-muted-foreground">
        <a href="#" class="transition-colors hover:text-foreground">Privacy Policy</a>
        <a href="#" class="transition-colors hover:text-foreground">Terms of Use</a>
        <a href={getRelativeLocaleUrl(locale, "rss.xml")} class="transition-colors hover:text-accent">RSS Feed</a>
      </div>
    </div>
  </div>
</footer>
