---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// Determine if we're on the homepage (hero image underneath → start transparent)
const isHomepage = currentPath === "/" || currentPath === "";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<!-- Sticky glassmorphism header -->
<header
  id="site-header"
  class:list={[
    "sticky top-0 z-40 w-full transition-all duration-300",
    isHomepage
      ? "header-transparent"
      : "bg-background/95 backdrop-blur-md border-b border-border shadow-sm",
  ]}
>
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 sm:px-6 py-3 sm:py-4">

    <!-- Logo / Site title -->
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="flex items-center gap-1.5 py-1 text-xl font-bold leading-none whitespace-nowrap sm:text-2xl transition-opacity hover:opacity-80"
    >
      <span class="text-accent header-logo-text transition-colors">Roam</span>
      <span class="header-logo-text transition-colors">China</span>
      <span class="text-muted-foreground font-normal text-base sm:text-lg header-logo-muted transition-colors">Travel</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 sm:flex">
      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class:list={[
          "nav-link rounded-lg px-4 py-2 text-sm font-medium transition-all duration-200 hover:bg-accent/10 hover:text-accent",
          isActive("/tags") ? "text-accent font-semibold" : "header-nav-text",
        ]}
      >
        Destinations
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class:list={[
          "nav-link rounded-lg px-4 py-2 text-sm font-medium transition-all duration-200 hover:bg-accent/10 hover:text-accent",
          isActive("/posts") ? "text-accent font-semibold" : "header-nav-text",
        ]}
      >
        Guides
      </a>

      {
        features.showArchives && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "archives")}
            class:list={[
              "nav-link relative flex size-9 items-center justify-center rounded-lg transition-all duration-200 hover:bg-accent/10",
              isActive("/archives") ? "text-accent" : "header-nav-text",
            ]}
            title={t.nav.archives}
            aria-label={t.nav.archives}
          >
            <IconArchive class="size-5" />
            {isActive("/archives") && (
              <IconUnderline aria-hidden="true" class="absolute bottom-0.5 w-5 scale-125" />
            )}
          </LinkButton>
        )
      }

      {
        features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "search")}
            class:list={[
              "nav-link relative flex size-9 items-center justify-center rounded-lg transition-all duration-200 hover:bg-accent/10",
              isActive("/search") ? "text-accent" : "header-nav-text",
            ]}
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="size-5" />
            {isActive("/search") && (
              <IconUnderline aria-hidden="true" class="absolute bottom-0.5 w-5 scale-125" />
            )}
          </LinkButton>
        )
      }

      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="nav-link hover:[&>svg]:stroke-accent relative flex size-9 items-center justify-center rounded-lg transition-all duration-200 hover:bg-accent/10 header-nav-text"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute size-5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute size-5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
    </nav>

    <!-- Mobile: right-side icons -->
    <div class="flex items-center gap-1 sm:hidden">
      {
        features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "search")}
            class="header-nav-text flex size-9 items-center justify-center rounded-lg"
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="size-5" />
          </LinkButton>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn-mobile"
            class="header-nav-text hover:[&>svg]:stroke-accent relative flex size-9 items-center justify-center rounded-lg"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute size-5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute size-5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
      <button
        id="menu-btn"
        class="header-nav-text focus-outline flex size-9 items-center justify-center rounded-lg"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden size-5" />
        <IconMenuDeep id="menu-icon" class="size-5" />
      </button>
    </div>
  </div>

  <!-- Mobile dropdown menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border/50 bg-background/98 backdrop-blur-md sm:hidden"
  >
    <nav class="mx-auto max-w-6xl space-y-1 px-4 py-3">
      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class:list={[
          "flex items-center rounded-lg px-4 py-2.5 text-sm font-medium transition-colors hover:bg-muted hover:text-accent",
          isActive("/tags") ? "bg-muted text-accent" : "text-foreground",
        ]}
      >
        Destinations
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class:list={[
          "flex items-center rounded-lg px-4 py-2.5 text-sm font-medium transition-colors hover:bg-muted hover:text-accent",
          isActive("/posts") ? "bg-muted text-accent" : "text-foreground",
        ]}
      >
        Guides
      </a>
      {
        features.showArchives && (
          <a
            href={getRelativeLocaleUrl(locale, "archives")}
            class:list={[
              "flex items-center rounded-lg px-4 py-2.5 text-sm font-medium transition-colors hover:bg-muted hover:text-accent",
              isActive("/archives") ? "bg-muted text-accent" : "text-foreground",
            ]}
          >
            {t.nav.archives}
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.getElementById("site-header");
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");

    // ── Sync mobile theme button with the main theme-btn ──
    const themeBtnMobile = document.getElementById("theme-btn-mobile");
    const themeBtn = document.getElementById("theme-btn");
    themeBtnMobile?.addEventListener("click", () => themeBtn?.click());

    // ── Hamburger toggle ──
    if (menuBtn && mobileMenu && menuIcon && closeIcon) {
      const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
      const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

      menuBtn.addEventListener("click", () => {
        const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
        menuBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");
        menuBtn.setAttribute("aria-label", isOpen ? openLabel : closeLabel);
        mobileMenu.classList.toggle("hidden");
        menuIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      });
    }

    if (!header) return;

    // ── Scroll-aware transparency (homepage only) ──
    const isHomepage = header.classList.contains("header-transparent");
    if (!isHomepage) return;

    const SCROLL_THRESHOLD = 60;

    function updateHeaderStyle() {
      const scrolled = window.scrollY > SCROLL_THRESHOLD;
      if (scrolled) {
        header!.classList.remove("header-transparent");
        header!.classList.add("bg-background/95", "backdrop-blur-md", "border-b", "border-border", "shadow-sm");
      } else {
        header!.classList.add("header-transparent");
        header!.classList.remove("bg-background/95", "backdrop-blur-md", "border-b", "border-border", "shadow-sm");
      }
    }

    window.addEventListener("scroll", updateHeaderStyle, { passive: true });
    updateHeaderStyle();
  }

  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>

<style>
  /* Transparent state (homepage, above fold) */
  .header-transparent {
    background: transparent;
  }
  .header-transparent .header-logo-text {
    color: #ffffff;
  }
  .header-transparent .header-logo-muted {
    color: rgba(255,255,255,0.65);
  }
  .header-transparent .header-nav-text {
    color: rgba(255,255,255,0.9);
  }
  .header-transparent .nav-link:hover {
    background-color: rgba(255,255,255,0.12) !important;
    color: #ffffff !important;
  }

  /* Solid state (scrolled / non-homepage) */
  :not(.header-transparent) .header-logo-text {
    color: inherit;
  }
  :not(.header-transparent) .header-nav-text {
    color: var(--muted-foreground);
  }
</style>
