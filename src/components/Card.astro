---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  cardStyle?: "list" | "grid";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", cardStyle = "list", id, data, filePath } = Astro.props;
const { title, description, tags, pubDatetime, modDatetime } = data;

const postUrl = getPostUrl(id, filePath, Astro.currentLocale);

// Thumbnail — deterministic per-article pick from the local image pool, so
// every card gets a distinct, stable image instead of all same-city articles
// sharing one photo (variety across listings; bento/themes stay place-accurate).
const POOL = ["beijing","pingyao","harbin","tianjin","dalian","changbai","shanghai","hangzhou","huangshan","suzhou","qingdao","nanjing","anhui","xidi","jiangxi","wuhan","zhangjiajie","fenghuang","luoyang","guangzhou","hainan","guilin","gulangyu","chaoshan","fuzhou","macau","chengdu","chongqing","jiuzhaigou","lijiang","zhangye","yunnan","dali","guizhou","tibet","xishuangbanna","xian","dunhuang","xinjiang","qinghai","kashgar"];
function poolPick(seed: string): string {
  let h = 5381;
  for (let i = 0; i < seed.length; i++) h = ((h << 5) + h + seed.charCodeAt(i)) >>> 0;
  return `/destinations/${POOL[h % POOL.length]}.jpg`;
}

const firstTag = (tags?.[0] ?? "").toLowerCase().replace(/[^a-z]/g, "");

// Prefer the article's own ogImage (local "/..." or remote "https://..."),
// so each card shows the article's real, de-duplicated cover; fall back to the
// per-id local pool only when an article has no ogImage at all.
const { ogImage } = data;
const thumbnail = (typeof ogImage === "string" && ogImage.length > 0)
  ? ogImage
  : poolPick(id);

const category = tags?.[0] ?? "";

// Badge colour per category
