---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale, getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// Transparent on homepage hero
const isHomepage = currentPath === "/" || currentPath === "";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<!-- Sticky glassmorphism header -->
<header
  id="site-header"
  class:list={[
    "sticky top-0 z-40 w-full transition-all duration-500",
    isHomepage
      ? "header-transparent"
      : "bg-background/96 backdrop-blur-xl border-b border-border/60 shadow-sm",
  ]}
>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 sm:px-6 py-3 sm:py-3.5">

    <!-- Logo / Site title -->
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="group flex items-center gap-1 py-1 leading-none whitespace-nowrap transition-all duration-200 hover:opacity-90"
    >
      <!-- Logo mark — site favicon (mountain & sun seal) -->
      <img
        src={getAssetPath("favicon.svg")}
        alt=""
        aria-hidden="true"
        width="28"
        height="28"
        class="mr-1 size-7 rounded-lg transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3"
      />
      <span
        class="text-lg font-extrabold leading-none header-logo-text transition-colors"
        style="font-family: var(--font-playfair), Georgia, serif; letter-spacing: -0.02em;"
      >
        Roam<span class="text-accent">China</span>
      </span>
      <span class="ml-0.5 text-xs font-medium header-logo-muted transition-colors hidden xs:inline">Travel</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-0.5 lg:flex">
      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class:list={[
          "nav-link rounded-lg px-3.5 py-2 text-sm font-medium transition-all duration-200 hover:bg-accent/10 hover:text-accent",
          isActive("/tags") ? "text-accent font-semibold bg-accent/8" : "header-nav-text",
        ]}
      >
        Destinations
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class:list={[
          "nav-link rounded-lg px-3.5 py-2 text-sm font-medium transition-all duration-200 hover:bg-accent/10 hover:text-accent",
          isActive("/posts") ? "text-accent font-semibold bg-accent/8" : "header-nav-text",
        ]}
      >
        Guides
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "toolkit")}
        class:list={[
          "nav-link rounded-lg px-3.5 py-2 text-sm font-medium transition-all duration-200 hover:bg-accent/10 hover:text-accent",
          isActive("/toolkit") ? "text-accent font-semibold bg-accent/8" : "header-nav-text",
        ]}
      >
        Toolkit
      </a>

      {
        features.showArchives && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "archives")}
            class:list={[
              "nav-link relative flex size-9 items-center justify-center rounded-lg transition-all duration-200 hover:bg-accent/10",
              isActive("/archives") ? "text-accent" : "header-nav-text",
            ]}
            title={t.nav.archives}
            aria-label={t.nav.archives}
          >
            <IconArchive class="size-4.5" />
            {isActive("/archives") && (
              <IconUnderline aria-hidden="true" class="absolute bottom-0.5 w-5 scale-125" />
            )}
          </LinkButton>
        )
      }

      {
        features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "search")}
            class:list={[
              "nav-link relative flex size-9 items-center justify-center rounded-lg transition-all duration-200 hover:bg-accent/10",
              isActive("/search") ? "text-accent" : "header-nav-text",
            ]}
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="size-4.5" />
            {isActive("/search") && (
              <IconUnderline aria-hidden="true" class="absolute bottom-0.5 w-5 scale-125" />
            )}
          </LinkButton>
        )
      }

      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="nav-link hover:[&>svg]:stroke-accent relative flex size-9 items-center justify-center rounded-lg transition-all duration-200 hover:bg-accent/10 header-nav-text"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute size-4.5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute size-4.5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }

      <!-- Plan Your Trip CTA -->
      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class="nav-cta ml-3 inline-flex items-center gap-1.5 rounded-xl bg-accent px-4 py-2 text-xs font-bold text-white shadow-md shadow-accent/25 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-accent/35 active:scale-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Plan Your Trip
      </a>
    </nav>

    <!-- Mobile: right-side icons -->
    <div class="flex items-center gap-1 lg:hidden">
      {
        features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "search")}
            class="header-nav-text flex size-9 items-center justify-center rounded-lg"
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="size-4.5" />
          </LinkButton>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn-mobile"
            class="header-nav-text hover:[&>svg]:stroke-accent relative flex size-9 items-center justify-center rounded-lg"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute size-4.5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute size-4.5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
      <button
        id="menu-btn"
        class="header-nav-text focus-outline flex size-9 items-center justify-center rounded-lg"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden size-4.5" />
        <IconMenuDeep id="menu-icon" class="size-4.5" />
      </button>
    </div>
  </div>

  <!-- Mobile dropdown menu — full-screen overlay feel -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border/50 bg-background/98 backdrop-blur-xl lg:hidden"
  >
    <nav class="mx-auto max-w-7xl space-y-0.5 px-4 py-3">
      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class:list={[
          "flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold transition-all hover:bg-muted hover:text-accent",
          isActive("/tags") ? "bg-muted text-accent" : "text-foreground",
        ]}
      >
        <span class="flex size-8 items-center justify-center rounded-lg bg-accent/10 text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </span>
        Destinations
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class:list={[
          "flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold transition-all hover:bg-muted hover:text-accent",
          isActive("/posts") ? "bg-muted text-accent" : "text-foreground",
        ]}
      >
        <span class="flex size-8 items-center justify-center rounded-lg bg-accent/10 text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
        </span>
        Guides
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "toolkit")}
        class:list={[
          "flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold transition-all hover:bg-muted hover:text-accent",
          isActive("/toolkit") ? "bg-muted text-accent" : "text-foreground",
        ]}
      >
        <span class="flex size-8 items-center justify-center rounded-lg bg-accent/10 text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </span>
        Toolkit
      </a>
      {
        features.showArchives && (
          <a
            href={getRelativeLocaleUrl(locale, "archives")}
            class:list={[
              "flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold transition-all hover:bg-muted hover:text-accent",
              isActive("/archives") ? "bg-muted text-accent" : "text-foreground",
            ]}
          >
            <span class="flex size-8 items-center justify-center rounded-lg bg-accent/10 text-accent">
              <IconArchive class="h-4 w-4" />
            </span>
            {t.nav.archives}
          </a>
        )
      }
      <!-- CTA at bottom of mobile menu -->
      <div class="pt-3 pb-1">
        <a
          href={getRelativeLocaleUrl(locale, "tags")}
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3 text-sm font-bold text-white shadow-md shadow-accent/20 transition-all active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Plan Your Trip
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.getElementById("site-header");
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");

    // ── Sync mobile theme button with the main theme-btn ──
    const themeBtnMobile = document.getElementById("theme-btn-mobile");
    const themeBtn = document.getElementById("theme-btn");
    themeBtnMobile?.addEventListener("click", () => themeBtn?.click());

    // ── Hamburger toggle ──
    if (menuBtn && mobileMenu && menuIcon && closeIcon) {
      const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
      const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

      menuBtn.addEventListener("click", () => {
        const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
        menuBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");
        menuBtn.setAttribute("aria-label", isOpen ? openLabel : closeLabel);
        mobileMenu.classList.toggle("hidden");
        menuIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");

        // Close menu when a nav link is tapped
        if (!isOpen) {
          mobileMenu.querySelectorAll("a").forEach(link => {
            link.addEventListener("click", () => {
              mobileMenu.classList.add("hidden");
              menuIcon.classList.remove("hidden");
              closeIcon.classList.add("hidden");
              menuBtn.setAttribute("aria-expanded", "false");
            }, { once: true });
          });
        }
      });
    }

    if (!header) return;

    // ── Scroll-aware transparency (homepage only) ──
    const isHomepage = header.classList.contains("header-transparent");
    if (!isHomepage) return;

    const SCROLL_THRESHOLD = 80;

    function updateHeaderStyle() {
      const scrolled = window.scrollY > SCROLL_THRESHOLD;
      if (scrolled) {
        header!.classList.remove("header-transparent");
        header!.classList.add("bg-background/96", "backdrop-blur-xl", "border-b", "border-border/60", "shadow-sm");
      } else {
        header!.classList.add("header-transparent");
        header!.classList.remove("bg-background/96", "backdrop-blur-xl", "border-b", "border-border/60", "shadow-sm");
      }
    }

    window.addEventListener("scroll", updateHeaderStyle, { passive: true });
    updateHeaderStyle();
  }

  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>

<style>
  /* Transparent state (homepage, above fold) */
  .header-transparent {
    background: transparent;
  }
  .header-transparent .header-logo-text {
    color: #ffffff;
  }
  .header-transparent .header-logo-muted {
    color: rgba(255,255,255,0.6);
  }
  .header-transparent .header-nav-text {
    color: rgba(255,255,255,0.88);
  }
  .header-transparent .nav-link:hover {
    background-color: rgba(255,255,255,0.12) !important;
    color: #ffffff !important;
  }
  .header-transparent .nav-cta {
    background-color: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.3);
    color: #ffffff;
    box-shadow: none;
  }
  .header-transparent .nav-cta:hover {
    background-color: rgba(255,255,255,0.28);
  }

  /* Solid state (scrolled / non-homepage) */
  :not(.header-transparent) .header-logo-text {
    color: var(--foreground);
  }
  :not(.header-transparent) .header-nav-text {
    color: var(--muted-foreground);
  }
</style>
