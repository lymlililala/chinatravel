---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const locale = Astro.currentLocale ?? config.site.lang;

// ── Region filter data ──
const regions = [
  { id: "all",          label: "All China",     emoji: "🇨🇳" },
  { id: "north",        label: "North",         emoji: "🏯" },
  { id: "northeast",    label: "Northeast",     emoji: "❄️" },
  { id: "east",         label: "East",          emoji: "🌆" },
  { id: "central",      label: "Central",       emoji: "🏔️" },
  { id: "south",        label: "South",         emoji: "🌊" },
  { id: "southwest",    label: "Southwest",     emoji: "🐼" },
  { id: "northwest",    label: "Northwest",     emoji: "🐪" },
];

// ── All destination cities with region tags ──
const cities = [
  // North China
  { name: "Beijing",        emoji: "🏯", tagline: "Imperial history & the Great Wall",          tag: "beijing",        image: "https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=700&q=80",  region: "north",     },
  { name: "Pingyao",        emoji: "🏰", tagline: "Best-preserved ancient walled city",          tag: "pingyao",        image: "https://images.unsplash.com/photo-1570797197190-8e003a00c846?w=700&q=80", region: "north",     },
  { name: "Tianjin",        emoji: "🏛️", tagline: "European concessions & tianjin cuisine",      tag: "tianjin",        image: "https://images.unsplash.com/photo-1519125323398-675f0ddb6308?w=700&q=80", region: "north",     },
  { name: "Inner Mongolia", emoji: "🐎", tagline: "Vast grasslands & nomadic culture",           tag: "innermongolia",  image: "https://images.unsplash.com/photo-1531761535209-180857e963b9?w=700&q=80", region: "north",     },
  // Northeast
  { name: "Harbin",         emoji: "❄️", tagline: "Ice & Snow World festival",                   tag: "harbin",         image: "https://images.unsplash.com/photo-1578894381163-e72c17f2d45f?w=700&q=80", region: "northeast",  },
  { name: "Dalian",         emoji: "🌊", tagline: "Rocky coastlines & Russian architecture",     tag: "dalian",         image: "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=700&q=80", region: "northeast",  },
  { name: "Changbai Mts",   emoji: "🌋", tagline: "Heavenly Lake & virgin forests",              tag: "changbai",       image: "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=700&q=80", region: "northeast",  },
  // East China
  { name: "Shanghai",       emoji: "🌆", tagline: "The skyline that never sleeps",               tag: "shanghai",       image: "https://images.unsplash.com/photo-1538428494232-9c0d8a3ab403?w=700&q=80", region: "east",      },
  { name: "Hangzhou",       emoji: "🍵", tagline: "West Lake & Dragon Well tea",                 tag: "hangzhou",       image: "https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?w=700&q=80", region: "east",      },
  { name: "Suzhou",         emoji: "🏡", tagline: "Classical gardens & canals",                  tag: "suzhou",         image: "https://images.unsplash.com/photo-1546410531-bb4caa6b424d?w=700&q=80", region: "east",      },
  { name: "Qingdao",        emoji: "🍺", tagline: "German heritage & blue sea",                  tag: "qingdao",        image: "https://images.unsplash.com/photo-1524492412937-b28074a5d7da?w=700&q=80", region: "east",      },
  { name: "Huangshan",      emoji: "🌄", tagline: "Sea of clouds & ancient pines",               tag: "huangshan",      image: "https://images.unsplash.com/photo-1490730141103-6cac27aaab94?w=700&q=80", region: "east",      },
  { name: "Ningbo",         emoji: "⛩️", tagline: "Putuoshan island & port heritage",            tag: "ningbo",         image: "https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=700&q=80",  region: "east",      },
  // Central China
  { name: "Wuhan",          emoji: "🏯", tagline: "Yellow Crane Tower & hot dry noodles",        tag: "wuhan",          image: "https://images.unsplash.com/photo-1532274402911-5a369e4c4bb5?w=700&q=80", region: "central",   },
  { name: "Zhangjiajie",    emoji: "🌁", tagline: "Avatar mountains & glass bridges",            tag: "zhangjiajie",    image: "https://images.unsplash.com/photo-1504457047772-27faf1c00561?w=700&q=80", region: "central",   },
  { name: "Fenghuang",      emoji: "🎐", tagline: "Ancient river town on stilts",               tag: "fenghuang",      image: "https://images.unsplash.com/photo-1513415756790-2ac1db1297d0?w=700&q=80", region: "central",   },
  { name: "Luoyang",        emoji: "🌸", tagline: "Peony capital & Longmen Grottoes",            tag: "luoyang",        image: "https://images.unsplash.com/photo-1503174971373-b1f69850bded?w=700&q=80", region: "central",   },
  { name: "Jiangxi",        emoji: "⛰️", tagline: "Lushan mountains & Jingdezhen porcelain",    tag: "jiangxi",        image: "https://images.unsplash.com/photo-1596422846543-75c6fc197f07?w=700&q=80", region: "central",   },
  // South China
  { name: "Guangzhou",      emoji: "🐉", tagline: "Cantonese cuisine & Pearl River",             tag: "guangzhou",      image: "https://images.unsplash.com/photo-1591604129939-f1efa4d9f7fa?w=700&q=80", region: "south",     },
  { name: "Guilin",         emoji: "⛰️", tagline: "Karst peaks & Li River cruise",              tag: "guilin",         image: "https://images.unsplash.com/photo-1513415756790-2ac1db1297d0?w=700&q=80", region: "south",     },
  { name: "Gulangyu",       emoji: "🎵", tagline: "Piano island & colonial architecture",        tag: "gulangyu",       image: "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=700&q=80", region: "south",     },
  { name: "Fujian Tulou",   emoji: "🏠", tagline: "Hakka earth buildings & rice terraces",       tag: "fujian",         image: "https://images.unsplash.com/photo-1566552881560-0be862a7c445?w=700&q=80", region: "south",     },
  { name: "Hainan",         emoji: "🏖️", tagline: "Tropical beaches & duty-free shopping",       tag: "hainan",         image: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=700&q=80", region: "south",     },
  { name: "Chaoshan",       emoji: "🍜", tagline: "Teochew cuisine & Guangji Bridge",             tag: "chaoshan",       image: "https://images.unsplash.com/photo-1534430480872-3498386e7856?w=700&q=80", region: "south",     },
  // Southwest
  { name: "Chengdu",        emoji: "🐼", tagline: "Pandas, hotpot & laid-back culture",          tag: "chengdu",        image: "https://images.unsplash.com/photo-1564349683136-77e08dba1ef7?w=700&q=80", region: "southwest", },
  { name: "Chongqing",      emoji: "🌶️", tagline: "Hillside mega-city & spicy hotpot",           tag: "chongqing",      image: "https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?w=700&q=80", region: "southwest", },
  { name: "Jiuzhaigou",     emoji: "💎", tagline: "Turquoise lakes & waterfalls",                tag: "jiuzhaigou",     image: "https://images.unsplash.com/photo-1504198266287-1659872e6590?w=700&q=80", region: "southwest", },
  { name: "Lijiang",        emoji: "🌸", tagline: "Naxi culture & Jade Dragon Snow Mountain",   tag: "lijiang",        image: "https://images.unsplash.com/photo-1588666309990-d68f08e3d4a6?w=700&q=80", region: "southwest", },
  { name: "Dali",           emoji: "🌊", tagline: "Ancient town by Erhai Lake",                  tag: "dali",           image: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=700&q=80",  region: "southwest", },
  { name: "Yunnan",         emoji: "🌈", tagline: "Ancient towns & mountain kingdoms",           tag: "yunnan",         image: "https://images.unsplash.com/photo-1548013146-72479768bada?w=700&q=80",  region: "southwest", },
  { name: "Guizhou",        emoji: "🎐", tagline: "Ethnic minority villages & waterfalls",       tag: "guizhou",        image: "https://images.unsplash.com/photo-1583417267826-aebc4d1542e1?w=700&q=80",  region: "southwest", },
  { name: "Tibet",          emoji: "🏔️", tagline: "Roof of the world & Potala Palace",          tag: "tibet",          image: "https://images.unsplash.com/photo-1524492412937-b28074a5d7da?w=700&q=80", region: "southwest", },
  { name: "Xishuangbanna",  emoji: "🌿", tagline: "Tropical rainforest & Dai culture",           tag: "xishuangbanna",  image: "https://images.unsplash.com/photo-1501854140801-50d01698950b?w=700&q=80", region: "southwest", },
  // Northwest
  { name: "Xi'an",          emoji: "🏺", tagline: "Terracotta Army & ancient walls",             tag: "xian",           image: "https://images.unsplash.com/photo-1547981609-4b6bfe67ca0b?w=700&q=80",  region: "northwest", },
  { name: "Dunhuang",       emoji: "🐪", tagline: "Silk Road, dunes & Mogao Caves",              tag: "dunhuang",       image: "https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=700&q=80", region: "northwest", },
  { name: "Xinjiang",       emoji: "🌄", tagline: "Kanas lake & Silk Road landscapes",           tag: "xinjiang",       image: "https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=700&q=80", region: "northwest", },
  { name: "Qinghai",        emoji: "🦩", tagline: "Qinghai Lake & Tibetan plateau",              tag: "qinghai",        image: "https://images.unsplash.com/photo-1501854140801-50d01698950b?w=700&q=80", region: "northwest", },
  { name: "Zhangye",        emoji: "🌈", tagline: "Rainbow Danxia landforms",                    tag: "zhangye",        image: "https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=700&q=80", region: "northwest", },
];

// ── Travel styles ──
const travelStyles = [
  { icon: "🍜", label: "Food & Cuisine",    tag: "food",      bg: "bg-amber-50 dark:bg-amber-900/20",    border: "border-amber-200 dark:border-amber-700/50",   text: "text-amber-700 dark:text-amber-300" },
  { icon: "🏛️", label: "Culture & History", tag: "culture",   bg: "bg-red-50 dark:bg-red-900/20",        border: "border-red-200 dark:border-red-700/50",       text: "text-red-700 dark:text-red-300" },
  { icon: "🥾", label: "Hiking & Nature",   tag: "nature",    bg: "bg-green-50 dark:bg-green-900/20",    border: "border-green-200 dark:border-green-700/50",   text: "text-green-700 dark:text-green-300" },
  { icon: "🎒", label: "Solo Travel",       tag: "solo",      bg: "bg-purple-50 dark:bg-purple-900/20",  border: "border-purple-200 dark:border-purple-700/50", text: "text-purple-700 dark:text-purple-300" },
  { icon: "👨‍👩‍👧", label: "Family Travel",    tag: "family",    bg: "bg-blue-50 dark:bg-blue-900/20",      border: "border-blue-200 dark:border-blue-700/50",    text: "text-blue-700 dark:text-blue-300" },
  { icon: "📸", label: "Photography",       tag: "photography",bg: "bg-pink-50 dark:bg-pink-900/20",     border: "border-pink-200 dark:border-pink-700/50",    text: "text-pink-700 dark:text-pink-300" },
  { icon: "🏖️", label: "Beach & Tropical",  tag: "beach",     bg: "bg-cyan-50 dark:bg-cyan-900/20",      border: "border-cyan-200 dark:border-cyan-700/50",    text: "text-cyan-700 dark:text-cyan-300" },
  { icon: "🕌", label: "Buddhist Culture",  tag: "buddhist-culture", bg: "bg-orange-50 dark:bg-orange-900/20", border: "border-orange-200 dark:border-orange-700/50", text: "text-orange-700 dark:text-orange-300" },
];

// ── Practical info ──
const practicalInfo = [
  { icon: "🛂", label: "Visa & Entry",       tag: "visa",      desc: "Tourist visas, 144-hr & 15-day visa-free" },
  { icon: "💳", label: "Money & Payment",    tag: "payment",   desc: "Alipay, WeChat Pay, foreign cards" },
  { icon: "📱", label: "Apps & Internet",    tag: "apps",      desc: "VPN, maps, translation apps" },
  { icon: "🚄", label: "Transport",          tag: "transport", desc: "High-speed trains, metro, flights" },
  { icon: "🌐", label: "Connectivity",       tag: "connectivity", desc: "SIM cards, eSIM, Wi-Fi" },
  { icon: "🚇", label: "Metro Systems",      tag: "metro",     desc: "Beijing, Shanghai subway guide" },
];
---

<Layout title={`Destinations & Guides | ${config.site.title}`}>
  <Header />

  <main id="main-content" class="pb-0">

    <!-- ── Page hero banner ── -->
    <div class="relative overflow-hidden border-b border-border bg-gradient-to-br from-background via-muted/40 to-background py-14 sm:py-18">
      <div class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-accent/6 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-12 -left-12 h-56 w-56 rounded-full bg-secondary/8 blur-3xl"></div>

      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <nav class="mb-4 flex items-center gap-2 text-sm text-muted-foreground" aria-label="Breadcrumb">
          <a href={getRelativeLocaleUrl(locale, "")} class="transition-colors hover:text-accent">Home</a>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-foreground font-medium">Destinations</span>
        </nav>
        <h1
          class="text-4xl font-extrabold text-foreground sm:text-5xl"
          style="font-family: var(--font-playfair), Georgia, serif; letter-spacing: -0.03em;"
        >
          Explore China
        </h1>
        <p class="mt-3 max-w-xl text-lg text-muted-foreground">
          Browse by destination, region, or travel style — everything you need for your China adventure.
        </p>

        <!-- Quick stats -->
        <div class="mt-6 flex flex-wrap gap-4 text-sm">
          <span class="flex items-center gap-1.5 text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
            <strong class="text-foreground">{cities.length}</strong> destinations
          </span>
          <span class="flex items-center gap-1.5 text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <strong class="text-foreground">{posts.length}</strong> guides published
          </span>
          <span class="flex items-center gap-1.5 text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Updated <strong class="text-foreground">2026</strong>
          </span>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-7xl space-y-16 px-4 py-12 sm:px-6">

      <!-- ══ SECTION 1: Destinations with region filter ══ -->
      <section>
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="overline mb-2">By city</p>
            <h2
              class="text-2xl font-extrabold text-foreground sm:text-3xl"
              style="font-family: var(--font-playfair), Georgia, serif;"
            >
              Popular Destinations
            </h2>
          </div>
        </div>

        <!-- Region filter pills -->
        <div
          class="mb-6 flex flex-wrap gap-2"
          id="region-filters"
          role="group"
          aria-label="Filter destinations by region"
        >
          {regions.map(region => (
            <button
              data-region={region.id}
              class:list={[
                "region-pill flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-xs font-semibold transition-all duration-200",
                region.id === "all"
                  ? "bg-accent text-white border-accent shadow-sm shadow-accent/20 pill-active"
                  : "border-border text-muted-foreground hover:border-accent/40 hover:text-foreground bg-background",
              ]}
            >
              <span>{region.emoji}</span>
              {region.label}
            </button>
          ))}
        </div>

        <!-- Cities grid -->
        <div
          id="cities-grid"
          class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4"
        >
          {cities.map(city => (
            <a
              href={getRelativeLocaleUrl(locale, `tags/${city.tag}`)}
              data-region={city.region}
              class="city-card group relative overflow-hidden rounded-2xl border border-border/60 shadow-sm transition-all duration-400 hover:shadow-xl hover:-translate-y-1.5 hover:border-accent/30"
              style="aspect-ratio: 3/2;"
            >
              <img
                src={city.image}
                alt={city.name}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-600 group-hover:scale-112"
                loading="lazy"
              />
              <!-- Bottom-fade so text stays readable without killing the photo -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/72 via-black/20 to-transparent"></div>
              <!-- Hover glow tint -->
              <div class="absolute inset-0 bg-accent/0 transition-all duration-400 group-hover:bg-accent/8"></div>

              <div class="absolute bottom-0 left-0 p-3 transition-transform duration-300 group-hover:-translate-y-0.5">
                <div class="flex items-center gap-1.5 text-white">
                  <span class="text-base" aria-hidden="true">{city.emoji}</span>
                  <span
                    class="font-bold text-sm sm:text-base drop-shadow"
                    style="font-family: var(--font-playfair), Georgia, serif;"
                  >{city.name}</span>
                </div>
                <p class="mt-0.5 text-[11px] text-white/72 leading-snug hidden sm:block line-clamp-1">{city.tagline}</p>
              </div>

              <!-- Arrow indicator -->
              <div class="absolute right-2.5 top-2.5 flex size-7 items-center justify-center rounded-full bg-white/0 text-white/0 transition-all duration-300 group-hover:bg-white/20 group-hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </a>
          ))}
        </div>

        <!-- Empty state -->
        <div id="cities-empty" class="hidden py-12 text-center">
          <span class="text-5xl">🗺️</span>
          <p class="mt-4 text-lg font-semibold text-foreground">No destinations in this region yet</p>
          <button
            data-region="all"
            class="region-pill mt-3 text-sm text-accent underline hover:no-underline"
          >View all destinations</button>
        </div>
      </section>

      <!-- ══ SECTION 2: Travel Styles ══ -->
      <section>
        <div class="mb-6">
          <p class="overline mb-2">How you travel</p>
          <h2
            class="text-2xl font-extrabold text-foreground sm:text-3xl"
            style="font-family: var(--font-playfair), Georgia, serif;"
          >
            Travel Styles
          </h2>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          {travelStyles.map(style => (
            <a
              href={getRelativeLocaleUrl(locale, `tags/${style.tag}`)}
              class:list={[
                "group flex flex-col items-center gap-2 rounded-2xl border p-4 sm:p-5 text-center transition-all duration-250 hover:shadow-md hover:-translate-y-1",
                style.bg, style.border,
              ]}
            >
              <span class="text-3xl transition-transform duration-200 group-hover:scale-115">{style.icon}</span>
              <span class:list={["text-sm font-bold leading-tight", style.text]}>{style.label}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- ══ SECTION 3: Practical Info ══ -->
      <section class="pb-4">
        <div class="mb-6">
          <p class="overline mb-2">Before you go</p>
          <h2
            class="text-2xl font-extrabold text-foreground sm:text-3xl"
            style="font-family: var(--font-playfair), Georgia, serif;"
          >
            Practical Information
          </h2>
          <p class="mt-1.5 text-sm text-muted-foreground">High-priority topics every international visitor needs to know.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {practicalInfo.map(item => (
            <a
              href={getRelativeLocaleUrl(locale, `tags/${item.tag}`)}
              class="group flex items-start gap-4 rounded-2xl border border-border bg-[var(--card-bg,#fff)] p-4 shadow-sm transition-all duration-200 hover:border-accent/30 hover:shadow-md hover:-translate-y-0.5"
            >
              <span class="mt-0.5 flex size-11 flex-shrink-0 items-center justify-center rounded-xl bg-muted text-xl transition-transform group-hover:scale-110">
                {item.icon}
              </span>
              <div class="min-w-0 flex-1">
                <h3
                  class="font-bold text-foreground transition-colors group-hover:text-accent"
                  style="font-family: var(--font-google-sans-code), monospace;"
                >{item.label}</h3>
                <p class="mt-0.5 text-sm text-muted-foreground">{item.desc}</p>
              </div>
              <IconArrowRight class="ml-auto mt-1.5 h-4 w-4 flex-shrink-0 text-muted-foreground/40 transition-all group-hover:translate-x-0.5 group-hover:text-accent" />
            </a>
          ))}
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const pills = document.querySelectorAll<HTMLButtonElement>(".region-pill");
    const cards = document.querySelectorAll<HTMLAnchorElement>(".city-card");
    const emptyState = document.getElementById("cities-empty");
    const grid = document.getElementById("cities-grid");

    if (!pills.length) return;

    function filterCities(regionId: string) {
      let visible = 0;

      // Update pill states
      pills.forEach(p => {
        const isActive = p.dataset.region === regionId;
        p.classList.toggle("bg-accent", isActive);
        p.classList.toggle("text-white", isActive);
        p.classList.toggle("border-accent", isActive);
        p.classList.toggle("shadow-sm", isActive);
        p.classList.toggle("pill-active", isActive);
        p.classList.toggle("border-border", !isActive);
        p.classList.toggle("text-muted-foreground", !isActive);
        p.classList.toggle("bg-background", !isActive);
      });

      // Show/hide cards with stagger
      cards.forEach((card, i) => {
        const matches = regionId === "all" || card.dataset.region === regionId;
        if (matches) {
          card.style.display = "";
          (card as HTMLElement).style.animationDelay = `${(i % 12) * 0.04}s`;
          card.classList.add("fade-card-in");
          visible++;
        } else {
          card.style.display = "none";
          card.classList.remove("fade-card-in");
        }
      });

      // Toggle empty state
      if (emptyState && grid) {
        emptyState.classList.toggle("hidden", visible > 0);
        grid.classList.toggle("hidden", visible === 0);
      }
    }

    pills.forEach(pill => {
      pill.addEventListener("click", () => {
        filterCities(pill.dataset.region ?? "all");
      });
    });
  });
</script>

<style>
  .group-hover\:scale-112:is(.group:hover *) { transform: scale(1.12); }
  .group:hover .group-hover\:scale-112 { transform: scale(1.12); }
  .group-hover\:scale-115:is(.group:hover *) { transform: scale(1.15); }
  .group:hover .group-hover\:scale-115 { transform: scale(1.15); }
  .duration-400 { transition-duration: 400ms; }
  .duration-600 { transition-duration: 600ms; }
  .duration-250 { transition-duration: 250ms; }

  @keyframes fadeCardIn {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .fade-card-in {
    animation: fadeCardIn 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
</style>
