---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// Hero background image pool — rotates daily for freshness
const heroImages = [
  { url: "/destinations/guilin.jpg", alt: "Karst limestone peaks rising from the Li River mist in Guilin, China" },
  { url: "/destinations/beijing.jpg", alt: "The Great Wall of China stretching over mountain ridges at golden hour" },
  { url: "/destinations/shanghai.jpg", alt: "Shanghai Bund and Pudong skyline reflecting on the Huangpu River" },
];
const heroImage = heroImages[new Date().getDate() % heroImages.length];

// Toolkit guides
const toolkitGuides = [
  {
    icon: "🛂",
    title: "Visa & Entry",
    desc: "144-hour & 15-day visa-free transit explained",
    href: getRelativeLocaleUrl(locale, "tags/visa"),
    cta: "Read guide",
    gradient: "from-red-500/12 to-orange-400/12",
    accent: "#c0392b",
    border: "border-red-200/60 dark:border-red-900/40",
  },
  {
    icon: "💳",
    title: "Money & Payment",
    desc: "Link your foreign card to Alipay & WeChat Pay",
    href: getRelativeLocaleUrl(locale, "tags/payment"),
    cta: "Read guide",
    gradient: "from-emerald-500/12 to-teal-400/12",
    accent: "#1a4b47",
    border: "border-emerald-200/60 dark:border-emerald-900/40",
  },
  {
    icon: "📱",
    title: "Apps & Internet",
    desc: "Must-have apps and VPN-free connectivity tips",
    href: getRelativeLocaleUrl(locale, "tags/apps"),
    cta: "Read guide",
    gradient: "from-blue-500/12 to-indigo-400/12",
    accent: "#2563eb",
    border: "border-blue-200/60 dark:border-blue-900/40",
  },
  {
    icon: "🚄",
    title: "Getting Around",
    desc: "How to book & ride China's high-speed trains",
    href: getRelativeLocaleUrl(locale, "tags/transport"),
    cta: "Read guide",
    gradient: "from-amber-500/12 to-yellow-400/12",
    accent: "#d97706",
    border: "border-amber-200/60 dark:border-amber-900/40",
  },
];

// Stats bar — dynamically computed from actual content
const totalGuides = posts.length;
const destinationCount = posts.filter(p => p.id.startsWith("destinations/")).length;
const currentYear = new Date().getFullYear();

const stats = [
  { value: `${totalGuides}+`, label: "In-depth guides" },
  { value: `${destinationCount}+`, label: "Destinations" },
  { value: String(currentYear), label: "Fully updated" },
  { value: "Free", label: "Always free" },
];

// ── Intent-based travel themes (Explore by Interest) ──
const travelThemes = [
  {
    icon: "🛂",
    title: "144-Hour Visa-Free",
    desc: "No visa needed — enter Beijing, Shanghai, Guangzhou & more for up to 6 days",
    href: getRelativeLocaleUrl(locale, "tags/visa"),
    tag: "HOT",
    tagColor: "bg-red-500",
    image: "/destinations/beijing.jpg",
  },
  {
    icon: "🐪",
    title: "Silk Road Journey",
    desc: "Xi'an → Dunhuang → Kashgar: ancient deserts, cave art, and nomadic culture",
    href: getRelativeLocaleUrl(locale, "tags/xian"),
    tag: "EPIC",
    tagColor: "bg-amber-500",
    image: "/destinations/dunhuang.jpg",
  },
  {
    icon: "🏔️",
    title: "Natural Wonders",
    desc: "Zhangjiajie avatar mountains, Jiuzhaigou turquoise lakes, Guilin karst",
    href: getRelativeLocaleUrl(locale, "tags/nature"),
    tag: "SCENIC",
    tagColor: "bg-emerald-500",
    image: "/destinations/zhangjiajie.jpg",
  },
  {
    icon: "🍜",
    title: "Foodie China",
    desc: "Sichuan hotpot, Cantonese dim sum, Beijing duck, Xi'an lamb skewers",
    href: getRelativeLocaleUrl(locale, "tags/food"),
    tag: "TASTE",
    tagColor: "bg-orange-500",
    image: "/destinations/guangzhou.jpg",
  },
  {
    icon: "🏯",
    title: "Imperial History",
    desc: "Forbidden City, Great Wall, Terracotta Army — 5,000 years in one trip",
    href: getRelativeLocaleUrl(locale, "tags/culture"),
    tag: "CULTURE",
    tagColor: "bg-red-700",
    image: "/destinations/xian.jpg",
  },
  {
    icon: "🐼",
    title: "Panda & Wildlife",
    desc: "Chengdu Giant Panda Base, Wolong Reserve, and Yunnan elephant sanctuary",
    href: getRelativeLocaleUrl(locale, "tags/chengdu"),
    tag: "WILDLIFE",
    tagColor: "bg-green-600",
    image: "/destinations/chengdu.jpg",
  },
];

// ── Survival steps (most-searched how-to topics) ──
const survivalSteps = [
  {
    step: "01",
    title: "Get Your Visa Sorted",
    short: "Check if your country qualifies for visa-free entry (15-day or 144-hour transit)",
    href: getRelativeLocaleUrl(locale, "posts/toolkit/china-visa-application-guide"),
    icon: "🛂",
    color: "from-red-500/15 to-rose-400/10",
    border: "border-red-200/60 dark:border-red-900/40",
  },
  {
    step: "02",
    title: "Set Up Mobile Payment",
    short: "Link your foreign Visa/Mastercard to Alipay — essential for paying anywhere",
    href: getRelativeLocaleUrl(locale, "posts/toolkit/china-digital-payment-foreigners-guide"),
    icon: "💳",
    color: "from-emerald-500/15 to-teal-400/10",
    border: "border-emerald-200/60 dark:border-emerald-900/40",
  },
  {
    step: "03",
    title: "Download Must-Have Apps",
    short: "Amap for navigation, DiDi for rides, DeepL for translation — before you land",
    href: getRelativeLocaleUrl(locale, "posts/toolkit/china-internet-apps-guide"),
    icon: "📱",
    color: "from-blue-500/15 to-indigo-400/10",
    border: "border-blue-200/60 dark:border-blue-900/40",
  },
  {
    step: "04",
    title: "Book High-Speed Trains",
    short: "Use Trip.com or 12306 to reserve seats — trains sell out weeks in advance",
    href: getRelativeLocaleUrl(locale, "posts/toolkit/china-train-booking-guide-foreigners"),
    icon: "🚄",
    color: "from-amber-500/15 to-yellow-400/10",
    border: "border-amber-200/60 dark:border-amber-900/40",
  },
];

// Bento grid destinations — varied sizes for visual interest
const bentoDests = [
  {
    name: "Beijing",
    tagline: "Imperial grandeur meets modern China",
    image: "/destinations/beijing.jpg",
    href: getRelativeLocaleUrl(locale, "tags/beijing"),
    size: "large",  // spans 2 rows
    emoji: "🏯",
  },
  {
    name: "Shanghai",
    tagline: "The skyline that never sleeps",
    image: "/destinations/shanghai.jpg",
    href: getRelativeLocaleUrl(locale, "tags/shanghai"),
    size: "medium",
    emoji: "🌆",
  },
  {
    name: "Guilin",
    tagline: "Karst peaks & emerald rivers",
    image: "/destinations/guilin.jpg",
    href: getRelativeLocaleUrl(locale, "tags/guilin"),
    size: "small",
    emoji: "⛰️",
  },
  {
    name: "Xi'an",
    tagline: "Cradle of Chinese civilisation",
    image: "/destinations/xian.jpg",
    href: getRelativeLocaleUrl(locale, "tags/xian"),
    size: "small",
    emoji: "🏺",
  },
  {
    name: "Chengdu",
    tagline: "Pandas, hotpot & laid-back vibes",
    image: "/destinations/chengdu.jpg",
    href: getRelativeLocaleUrl(locale, "tags/chengdu"),
    size: "medium",
    emoji: "🐼",
  },
  {
    name: "Yunnan",
    tagline: "Ancient towns & mountain kingdoms",
    image: "/destinations/yunnan.jpg",
    href: getRelativeLocaleUrl(locale, "tags/yunnan"),
    size: "small",
    emoji: "🌸",
  },
];

// Featured article (first featured post for magazine hero layout)
const featuredHero = featuredPosts[0];
const featuredSidebar = featuredPosts.slice(1, 4);

// Thumbnail helper function for magazine cards.
// 缩略图取自 public/destinations/*.jpg（本地静态图）。映射覆盖目的地 tag + 主题 tag，
// 并遍历文章所有 tag 找首个命中；都不中时按文章 id 在图池里做「确定性」分配，
// 避免大量文章都退回同一张默认图而在首页撞图。
const thumbMap: Record<string, string> = {
  // 城市 / 目的地
  beijing: "/destinations/beijing.jpg", shanghai: "/destinations/shanghai.jpg",
  xian: "/destinations/xian.jpg", chengdu: "/destinations/chengdu.jpg",
  guilin: "/destinations/guilin.jpg", chongqing: "/destinations/chongqing.jpg",
  guangzhou: "/destinations/guangzhou.jpg", nanjing: "/destinations/nanjing.jpg",
  hangzhou: "/destinations/hangzhou.jpg", suzhou: "/destinations/suzhou.jpg",
  harbin: "/destinations/harbin.jpg", dalian: "/destinations/dalian.jpg",
  qingdao: "/destinations/qingdao.jpg", tianjin: "/destinations/tianjin.jpg",
  wuhan: "/destinations/wuhan.jpg", fuzhou: "/destinations/fuzhou.jpg",
  luoyang: "/destinations/luoyang.jpg", pingyao: "/destinations/pingyao.jpg",
  dunhuang: "/destinations/dunhuang.jpg", kashgar: "/destinations/kashgar.jpg",
  lijiang: "/destinations/lijiang.jpg", dali: "/destinations/dali.jpg",
  fenghuang: "/destinations/fenghuang.jpg", macau: "/destinations/macau.jpg",
  gulangyu: "/destinations/gulangyu.jpg",
  // 省 / 区域
  yunnan: "/destinations/yunnan.jpg", tibet: "/destinations/tibet.jpg",
  xinjiang: "/destinations/xinjiang.jpg", guizhou: "/destinations/guizhou.jpg",
  qinghai: "/destinations/qinghai.jpg", hainan: "/destinations/hainan.jpg",
  anhui: "/destinations/anhui.jpg", jiangxi: "/destinations/jiangxi.jpg",
  sichuan: "/destinations/chengdu.jpg", gansu: "/destinations/dunhuang.jpg",
  jiangsu: "/destinations/nanjing.jpg", zhejiang: "/destinations/hangzhou.jpg",
  fujian: "/destinations/fuzhou.jpg", henan: "/destinations/luoyang.jpg",
  shaanxi: "/destinations/xian.jpg", guangdong: "/destinations/guangzhou.jpg",
  changbai: "/destinations/changbai.jpg", chaoshan: "/destinations/chaoshan.jpg",
  xishuangbanna: "/destinations/xishuangbanna.jpg", jiuzhaigou: "/destinations/jiuzhaigou.jpg",
  zhangjiajie: "/destinations/zhangjiajie.jpg", huangshan: "/destinations/huangshan.jpg",
  xidi: "/destinations/xidi.jpg",
  // 主题 tag → 代表图
  visa: "/destinations/beijing.jpg", transport: "/destinations/shanghai.jpg",
  food: "/destinations/chengdu.jpg", nature: "/destinations/zhangjiajie.jpg",
  hiking: "/destinations/huangshan.jpg", history: "/destinations/xian.jpg",
  culture: "/destinations/pingyao.jpg", "silk-road": "/destinations/dunhuang.jpg",
  buddhism: "/destinations/dunhuang.jpg", coastal: "/destinations/qingdao.jpg",
  desert: "/destinations/dunhuang.jpg", urban: "/destinations/shanghai.jpg",
  "minority-cultures": "/destinations/guizhou.jpg",
};
// 小图与大图共用同一张映射表
const thumbMapSm = thumbMap;
// 兜底图池（无 tag 命中时按文章 id 确定性挑一张，避免全撞同一张默认图）
const fallbackPool = [
  "/destinations/zhangjiajie.jpg", "/destinations/jiuzhaigou.jpg", "/destinations/guilin.jpg",
  "/destinations/huangshan.jpg", "/destinations/yunnan.jpg", "/destinations/xian.jpg",
  "/destinations/chengdu.jpg", "/destinations/shanghai.jpg", "/destinations/dunhuang.jpg",
  "/destinations/qinghai.jpg",
];
const defaultThumb = "/destinations/zhangjiajie.jpg";
const defaultThumbSm = "/destinations/jiuzhaigou.jpg";

function hashId(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return h;
}

function getPostThumb(tags: string[] | undefined, large = true, id = ""): string {
  const map = large ? thumbMap : thumbMapSm;
  for (const raw of tags ?? []) {
    const tag = String(raw).toLowerCase().replace(/[^a-z]/g, "");
    if (map[tag]) return map[tag];
  }
  // 无 tag 命中：按 id 在图池里确定性分配（同一文章固定一张，不同文章尽量错开）
  if (id) return fallbackPool[hashId(id) % fallbackPool.length];
  return large ? defaultThumb : defaultThumbSm;
}

// 全部本地缩略图（去重用：撞图时从这里挑一张未占用的，保证同屏卡片不重复）
const ALL_THUMBS = [...new Set([...Object.values(thumbMap), ...fallbackPool])];

// 给一组文章分配缩略图，并保证组内不重复：首选 tag 映射，撞了就按 id 顺延到未用过的图。
function assignUniqueThumbs(
  list: { data: { tags?: string[] }; id: string }[],
  large = true,
  used: Set<string> = new Set()
): string[] {
  return list.map(p => {
    let pick = getPostThumb(p.data.tags, large, p.id);
    if (used.has(pick)) {
      const start = hashId(p.id) % ALL_THUMBS.length;
      for (let i = 0; i < ALL_THUMBS.length; i++) {
        const cand = ALL_THUMBS[(start + i) % ALL_THUMBS.length];
        if (!used.has(cand)) { pick = cand; break; }
      }
    }
    used.add(pick);
    return pick;
  });
}

// Pre-compute magazine thumbnails —— hero 与侧栏、近期卡片整体去重，避免同屏撞图
const usedThumbs = new Set<string>();
const featuredHeroThumb = featuredHero ? assignUniqueThumbs([featuredHero], true, usedThumbs)[0] : defaultThumb;
const featuredSidebarThumbs = assignUniqueThumbs(featuredSidebar, false, usedThumbs);
const recentSidebarThumbs = assignUniqueThumbs(recentPosts.slice(0, 3), false, usedThumbs);

// Post URL helper
function getSimplePostUrl(id: string): string {
  return `/posts/${id.replace(/^(destinations|toolkit)\//, "")}/`;
}
---

<Layout
  title="China Travel Guide 2026: Visa, Payments & Destinations | Roam China Travel"
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
  >

    <!-- ═══════════════════════════════════════════
         HERO — near-full-viewport banner (leaves a peek
         of the next section above the fold)
    ════════════════════════════════════════════ -->
    <section
      id="hero"
      class="relative -mt-[var(--header-h,64px)] flex flex-col overflow-hidden"
      style="min-height: 88svh;"
    >
      <!-- Background with parallax effect -->
      <div class="absolute inset-0 z-0" id="hero-bg">
        <img
          src={heroImage.url}
          alt={heroImage.alt}
          class="h-full w-full object-cover object-center"
          id="hero-img"
          loading="eager"
          fetchpriority="high"
          draggable="false"
        />
        <!-- Multi-stop gradient — depth & readability -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/25 to-black/88"></div>
        <!-- Radial vignette -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_45%,rgba(0,0,0,0.38)_100%)]"></div>
        <!-- Warm colour grading overlay -->
        <div class="absolute inset-0 bg-gradient-to-br from-amber-950/10 via-transparent to-red-950/15"></div>
      </div>

      <!-- Hero content -->
      <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col items-start justify-center px-4 pt-28 pb-16 sm:px-6 sm:pt-32 sm:pb-20">

        <div class="hero-animate-in max-w-2xl xl:max-w-3xl">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 backdrop-blur-sm">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-400"></span>
            <span class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">Your independent guide to</span>
          </div>

          <h1
            class="mb-5 leading-[1.08] text-white"
            style="font-family: var(--font-playfair), Georgia, serif; font-size: clamp(2.6rem, 6vw, 5rem); font-weight: 800; text-shadow: 0 2px 24px rgba(0,0,0,0.35);"
          >
            Travelling<br />
            <span class="text-amber-400 italic">China</span>
            <span class="font-light opacity-70 text-[0.75em]"> in 2026</span>
          </h1>

          <p class="mb-8 max-w-xl text-base text-white/82 sm:text-lg leading-relaxed">
            Honest, up-to-date advice on visas, payments, transport, and
            hidden gems — written for first-timers and seasoned backpackers.
          </p>

          <!-- CTA buttons -->
          <div class="mb-10 flex flex-wrap gap-3">
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class="group inline-flex items-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-sm font-bold text-white shadow-xl shadow-accent/30 transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-accent/40 active:scale-100"
            >
              Explore Guides
              <IconArrowRight class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
            <a
              href={getRelativeLocaleUrl(locale, "tags")}
              class="inline-flex items-center gap-2 rounded-xl border border-white/35 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-300 hover:bg-white/20 hover:border-white/55"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Browse Destinations
            </a>
          </div>

          <!-- Quick search bar -->
          <div class="hero-search-bar relative w-full max-w-lg">
            <div class="relative flex items-center overflow-hidden rounded-2xl border border-white/22 bg-white/12 backdrop-blur-md transition-all duration-300 focus-within:border-white/50 focus-within:bg-white/18 focus-within:shadow-lg focus-within:shadow-black/20">
              <span class="pointer-events-none pl-4 text-white/55">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"/>
                </svg>
              </span>
              <input
                id="hero-search-input"
                type="text"
                placeholder="Search guides, destinations, topics…"
                class="w-full bg-transparent px-3 py-3.5 text-sm text-white placeholder-white/45 outline-none"
                autocomplete="off"
              />
              <a
                id="hero-search-btn"
                href={getRelativeLocaleUrl(locale, "search")}
                class="mr-1.5 flex-shrink-0 rounded-xl bg-white/20 px-4 py-2 text-xs font-bold text-white transition-all hover:bg-white/32 active:scale-95"
              >
                Search
              </a>
            </div>
            <!-- Quick-search tags -->
            <div class="mt-3 flex flex-wrap gap-2">
              {["Visa-free", "Train tickets", "Alipay setup", "Best time to visit", "Street food"].map(q => (
                <a
                  href={`${getRelativeLocaleUrl(locale, "search")}?q=${encodeURIComponent(q)}`}
                  class="rounded-full border border-white/22 bg-white/10 px-3 py-1 text-xs text-white/72 backdrop-blur-sm transition-all hover:bg-white/20 hover:text-white hover:border-white/45 active:scale-95"
                >
                  {q}
                </a>
              ))}
            </div>
            <!-- Free tool CTA -->
            <div class="mt-5">
              <a
                href={getRelativeLocaleUrl(locale, "visa-checker")}
                class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-black/20 transition-all hover:scale-105 active:scale-100"
              >
                <span aria-hidden="true">🛂</span>
                Do I need a visa? Check in 10 seconds
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="relative z-10 border-t border-white/10 bg-black/30 backdrop-blur-sm">
        <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-white/10 px-4 sm:grid-cols-4 sm:px-6">
          {stats.map(stat => (
            <div class="flex flex-col items-center py-4 px-2 text-center">
              <span
                class="text-2xl font-extrabold text-white sm:text-3xl"
                style="font-family: var(--font-playfair), Georgia, serif;"
              >{stat.value}</span>
              <span class="mt-0.5 text-[10px] text-white/52 uppercase tracking-widest">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         ESSENTIAL TOOLKIT
    ════════════════════════════════════════════ -->
    <section id="toolkit" class="border-b border-border py-16 observe-fade">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mb-10 text-center">
          <p class="overline mb-2">Before you go</p>
          <h2
            class="text-3xl font-extrabold text-foreground sm:text-4xl"
            style="font-family: var(--font-playfair), Georgia, serif;"
          >
            Essential Toolkit
          </h2>
          <p class="mt-2 text-base text-muted-foreground max-w-lg mx-auto">
            Everything international travellers need to navigate China with confidence.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {toolkitGuides.map((guide) => (
            <a
              href={guide.href}
              class:list={[
                "group relative flex flex-col gap-4 overflow-hidden rounded-2xl p-6",
                "border bg-gradient-to-br",
                guide.gradient, guide.border,
                "bg-[var(--card-bg)] shadow-sm transition-all duration-300",
                "hover:shadow-xl hover:-translate-y-2 hover:border-accent/25",
              ]}
            >
